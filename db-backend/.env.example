# Database Connection Strings (Oracle)

# Staging Environment
DB_USER_STAGE=your_stage_user
DB_PASSWORD_STAGE=your_stage_password
DB_DSN_STAGE=your_stage_dsn_or_host:port/service_name

# Production Environment
DB_USER_PROD=your_prod_user
DB_PASSWORD_PROD=your_prod_password
DB_DSN_PROD=your_prod_dsn_or_host:port/service_name
